{
  "$defs": {
    "CrossPackGrantSpec": {
      "description": "Specification of an explicit cross-pack panel membership grant.\n\nGoverns which external packs and agents are authorized to participate\nin deliberation panels contributed by this pack (ADR 0001 \u00a72.9).",
      "properties": {
        "pack": {
          "description": "Target pack slug or domain identifier authorized for cross-pack collaboration",
          "title": "Pack",
          "type": "string"
        },
        "panels": {
          "description": "Optional list of specific panel IDs permitted to include this pack's agents. If empty, all panels in this pack are permitted.",
          "items": {
            "type": "string"
          },
          "title": "Panels",
          "type": "array"
        },
        "agents": {
          "description": "Optional list of specific agent IDs permitted. If empty, all agents from the granted pack are permitted.",
          "items": {
            "type": "string"
          },
          "title": "Agents",
          "type": "array"
        }
      },
      "required": [
        "pack"
      ],
      "title": "CrossPackGrantSpec",
      "type": "object"
    },
    "DelegationReminderSpec": {
      "additionalProperties": false,
      "description": "A short reminder the main agent reads with the latest user message\n(``orchestration.delegation.reminder``).\n\nSome models stop applying system-prompt delegation rules once the\nconversation has history. The reminder is appended to a model-only copy of\nthe turn's user message; the saved conversation keeps the user's words.",
      "properties": {
        "text": {
          "description": "Reminder appended to the model's copy of the latest user message.",
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "when": {
          "default": "follow_up",
          "description": "follow_up: only when the conversation already has a reply; always: on every turn that ends with a user message.",
          "enum": [
            "follow_up",
            "always"
          ],
          "title": "When",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "DelegationReminderSpec",
      "type": "object"
    },
    "DelegationSpec": {
      "additionalProperties": false,
      "description": "When the main agent hands work to specialists (``orchestration.delegation``).\n\nThe base prompt tells the main agent to answer directly when no specialist\nis needed. A pack can say when its specialists should take the work\ninstead, for example follow-up questions about an earlier specialist answer.",
      "properties": {
        "instructions": {
          "default": "",
          "description": "Guidance added to the main agent's system prompt on when to hand work to specialists.",
          "maxLength": 4000,
          "title": "Instructions",
          "type": "string"
        },
        "reminder": {
          "anyOf": [
            {
              "$ref": "#/$defs/DelegationReminderSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional per-turn reminder next to the latest user message (model input only; off by default)."
        }
      },
      "title": "DelegationSpec",
      "type": "object"
    },
    "FixedRoute": {
      "additionalProperties": false,
      "description": "A pack-declared deterministic route, evaluated before the main agent, in declared order.",
      "properties": {
        "route_id": {
          "pattern": "^[a-z0-9_-]{1,64}$",
          "title": "Route Id",
          "type": "string"
        },
        "when": {
          "discriminator": {
            "mapping": {
              "guardrail_flag": "#/$defs/GuardrailFlagTrigger",
              "has_attachments": "#/$defs/HasAttachmentsTrigger"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/HasAttachmentsTrigger"
            },
            {
              "$ref": "#/$defs/GuardrailFlagTrigger"
            }
          ],
          "title": "When"
        },
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "when",
        "agent_id"
      ],
      "title": "FixedRoute",
      "type": "object"
    },
    "GuardCheckSpec": {
      "additionalProperties": false,
      "description": "One guard check (an entry of ``safety.guards.checks``).",
      "properties": {
        "id": {
          "description": "Check id; also names its environment variables.",
          "pattern": "^[a-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "rules",
            "model"
          ],
          "title": "Type",
          "type": "string"
        },
        "stages": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "input",
                  "output"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the check runs. Default: rules both stages, model output only.",
          "title": "Stages"
        },
        "mode": {
          "default": "enforce",
          "description": "enforce: the verdict counts; shadow: run and audit only; off: do not run.",
          "enum": [
            "enforce",
            "shadow",
            "off"
          ],
          "title": "Mode",
          "type": "string"
        },
        "required": {
          "default": false,
          "description": "A required check cannot be switched to shadow or off by environment variables.",
          "title": "Required",
          "type": "boolean"
        },
        "on_block": {
          "default": "refuse",
          "description": "refuse: replace the answer; warn: keep it and flag a boundary warning.",
          "enum": [
            "refuse",
            "warn"
          ],
          "title": "On Block",
          "type": "string"
        },
        "blocks": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "description": "Named regex fragments. <NAME> in a pattern inserts one; a list becomes (?:a|b).",
          "title": "Blocks",
          "type": "object"
        },
        "normalize": {
          "items": {
            "$ref": "#/$defs/RuleNormalizeSpec"
          },
          "title": "Normalize",
          "type": "array"
        },
        "exempt": {
          "description": "Regexes whose matches are blanked out before patterns are checked.",
          "items": {
            "type": "string"
          },
          "title": "Exempt",
          "type": "array"
        },
        "patterns": {
          "items": {
            "$ref": "#/$defs/RulePatternSpec"
          },
          "title": "Patterns",
          "type": "array"
        },
        "sentence_split": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Regex splitting text into sentences.",
          "title": "Sentence Split"
        },
        "rules_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pack resource (YAML) with blocks/normalize/exempt/patterns/sentence_split.",
          "title": "Rules File"
        },
        "max_chars": {
          "default": 100000,
          "description": "Longer text is not checked and counts as unchecked (blocked unless on_abstain is allow).",
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Chars",
          "type": "integer"
        },
        "preset": {
          "anyOf": [
            {
              "enum": [
                "llama_guard",
                "granite_guardian",
                "labels",
                "json"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults for a known guard reply format.",
          "title": "Preset"
        },
        "style": {
          "anyOf": [
            {
              "enum": [
                "moderation",
                "prompt"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "moderation: send the conversation (user message, then answer) as chat messages; prompt: send one message built from `prompt`.",
          "title": "Style"
        },
        "system": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional system message.",
          "title": "System"
        },
        "prompt": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Template for style=prompt. {{text}}, {{prompt}} and {{stage}} are replaced.",
          "title": "Prompt"
        },
        "prompt_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pack resource holding the prompt template.",
          "title": "Prompt File"
        },
        "output": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelOutputSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "$ref": "#/$defs/ModelEndpointSpec"
        },
        "timeout_s": {
          "default": 10.0,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeout S",
          "type": "number"
        },
        "include_prompt": {
          "default": true,
          "description": "On the output stage, also send the user's message as context.",
          "title": "Include Prompt",
          "type": "boolean"
        },
        "when_unconfigured": {
          "default": "allow",
          "description": "No model configured: allow skips the check (a warning names it at startup); block or refuse refuses every answer it would check.",
          "enum": [
            "block",
            "refuse",
            "allow"
          ],
          "title": "When Unconfigured",
          "type": "string"
        },
        "on_abstain": {
          "default": "block",
          "description": "Model not sure, or text too long.",
          "enum": [
            "block",
            "refuse",
            "allow"
          ],
          "title": "On Abstain",
          "type": "string"
        },
        "on_error": {
          "default": "block",
          "description": "Timeout, failed call or unreadable reply.",
          "enum": [
            "block",
            "refuse",
            "allow"
          ],
          "title": "On Error",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "GuardCheckSpec",
      "type": "object"
    },
    "GuardrailFlagTrigger": {
      "additionalProperties": false,
      "description": "Fires when the input guardrail raises the named flag.",
      "properties": {
        "kind": {
          "const": "guardrail_flag",
          "default": "guardrail_flag",
          "title": "Kind",
          "type": "string"
        },
        "flag": {
          "pattern": "^[a-z0-9_-]{1,64}$",
          "title": "Flag",
          "type": "string"
        }
      },
      "required": [
        "flag"
      ],
      "title": "GuardrailFlagTrigger",
      "type": "object"
    },
    "HasAttachmentsTrigger": {
      "additionalProperties": false,
      "description": "Fires when the user turn carries attachments, optionally of given media types.",
      "properties": {
        "kind": {
          "const": "has_attachments",
          "default": "has_attachments",
          "title": "Kind",
          "type": "string"
        },
        "mime_types": {
          "description": "Optional media types or 'type/*' wildcards; empty matches any attachment.",
          "items": {
            "type": "string"
          },
          "title": "Mime Types",
          "type": "array"
        }
      },
      "title": "HasAttachmentsTrigger",
      "type": "object"
    },
    "ModelEndpointSpec": {
      "additionalProperties": false,
      "description": "Where a model check's model runs. Environment variables override every field.",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model provider, e.g. ollama, openai, custom.",
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Model name at the provider.",
          "title": "Model"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Endpoint URL for ollama or custom providers.",
          "title": "Base Url"
        },
        "temperature": {
          "default": 0.0,
          "maximum": 2.0,
          "minimum": 0.0,
          "title": "Temperature",
          "type": "number"
        }
      },
      "title": "ModelEndpointSpec",
      "type": "object"
    },
    "ModelOutputSpec": {
      "additionalProperties": false,
      "description": "How a model check reads the model's reply.\n\n``labels``: the first word of the reply is matched against ``allow_labels``\nand ``block_labels`` (case-insensitive). Categories are read from the rest\nof the first line or the next line, comma separated.\n\n``json``: the first JSON object in the reply is read. ``decision`` is\nmatched against the same labels; ``abstain_labels`` mean the model is not\nsure. With ``block_threshold`` / ``allow_threshold`` set, ``score``\ndecides instead: at or above block_threshold blocks, at or below\nallow_threshold allows, in between abstains.\n\nAnything else is an unreadable reply and counts as an error.",
      "properties": {
        "format": {
          "default": "labels",
          "enum": [
            "labels",
            "json"
          ],
          "title": "Format",
          "type": "string"
        },
        "allow_labels": {
          "items": {
            "type": "string"
          },
          "title": "Allow Labels",
          "type": "array"
        },
        "block_labels": {
          "items": {
            "type": "string"
          },
          "title": "Block Labels",
          "type": "array"
        },
        "abstain_labels": {
          "items": {
            "type": "string"
          },
          "title": "Abstain Labels",
          "type": "array"
        },
        "decision_key": {
          "default": "decision",
          "title": "Decision Key",
          "type": "string"
        },
        "category_key": {
          "default": "category",
          "title": "Category Key",
          "type": "string"
        },
        "score_key": {
          "default": "score",
          "title": "Score Key",
          "type": "string"
        },
        "block_threshold": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Threshold"
        },
        "allow_threshold": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allow Threshold"
        },
        "block_categories": {
          "description": "When set, a block verdict counts only if the model names one of these categories; other categories are allowed and recorded.",
          "items": {
            "type": "string"
          },
          "title": "Block Categories",
          "type": "array"
        }
      },
      "title": "ModelOutputSpec",
      "type": "object"
    },
    "OrchestrationLimits": {
      "additionalProperties": false,
      "description": "Per-turn bounds on subagent fan-out and wall-clock time.",
      "properties": {
        "max_agents": {
          "default": 4,
          "description": "Maximum number of subagent task calls in one turn.",
          "maximum": 16,
          "minimum": 1,
          "title": "Max Agents",
          "type": "integer"
        },
        "agent_timeout_s": {
          "default": 60.0,
          "description": "Wall-clock timeout for a single subagent task, in seconds.",
          "exclusiveMinimum": 0,
          "title": "Agent Timeout S",
          "type": "number"
        },
        "turn_timeout_s": {
          "default": 120.0,
          "description": "Wall-clock budget for the whole turn, in seconds.",
          "exclusiveMinimum": 0,
          "title": "Turn Timeout S",
          "type": "number"
        }
      },
      "title": "OrchestrationLimits",
      "type": "object"
    },
    "PackMigrationsSpec": {
      "description": "Specification of Alembic database migration branch contributed by a pack.",
      "properties": {
        "branch": {
          "description": "Alembic branch label e.g. 'health', 'finance', 'kids'",
          "title": "Branch",
          "type": "string"
        },
        "version_table": {
          "description": "Dedicated version tracking table e.g. 'alembic_version_health'",
          "title": "Version Table",
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Relative directory containing migration revisions",
          "title": "Location"
        },
        "depends_on_core": {
          "default": "core@0010",
          "description": "Earliest core schema revision required",
          "title": "Depends On Core",
          "type": "string"
        }
      },
      "required": [
        "branch",
        "version_table"
      ],
      "title": "PackMigrationsSpec",
      "type": "object"
    },
    "PackOrchestrationSpec": {
      "additionalProperties": false,
      "description": "Pack-level orchestration config (``orchestration:`` in pack.yaml).\n\n``default_agent`` handles the turn when no model is configured (after fixed\nroutes) and when the main agent cannot run; both cases carry a\nuser-visible notice. It is never substituted silently for an unknown id.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "default_agent": {
          "title": "Default Agent",
          "type": "string"
        },
        "fixed_routes": {
          "items": {
            "$ref": "#/$defs/FixedRoute"
          },
          "title": "Fixed Routes",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/OrchestrationLimits"
        },
        "delegation": {
          "$ref": "#/$defs/DelegationSpec"
        },
        "synthesis": {
          "$ref": "#/$defs/SynthesisSpec"
        }
      },
      "required": [
        "default_agent"
      ],
      "title": "PackOrchestrationSpec",
      "type": "object"
    },
    "PackPanelSpec": {
      "description": "Specification of a multi-agent deliberation panel in a pack.",
      "properties": {
        "id": {
          "description": "Panel slug identifier",
          "pattern": "^[a-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "description": "Display title for the panel",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Purpose and objective of the panel",
          "title": "Description",
          "type": "string"
        },
        "agents": {
          "description": "Specialist agent IDs participating in the panel",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Agents",
          "type": "array"
        },
        "max_rounds": {
          "default": 2,
          "description": "Deliberation round limit (default 2)",
          "maximum": 4,
          "minimum": 1,
          "title": "Max Rounds",
          "type": "integer"
        },
        "default_constraints": {
          "description": "Default shared constraints for this panel",
          "items": {
            "$ref": "#/$defs/PanelDefaultConstraintSpec"
          },
          "title": "Default Constraints",
          "type": "array"
        },
        "scopes": {
          "description": "Domain scopes participating in the panel (single scope in Phase 1)",
          "items": {
            "type": "string"
          },
          "title": "Scopes",
          "type": "array"
        },
        "cross_pack_grants": {
          "description": "Explicit cross-pack grants authorizing foreign pack/domain agents on this specific panel (ADR 0001 \u00a72.9)",
          "items": {
            "type": "string"
          },
          "title": "Cross Pack Grants",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "agents"
      ],
      "title": "PackPanelSpec",
      "type": "object"
    },
    "PackProvidesSpec": {
      "description": "Declarative manifest entries contributed by a pack on disk.",
      "properties": {
        "agents_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "agents/",
          "description": "Directory containing agent definitions",
          "title": "Agents Dir"
        },
        "skills_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "skills/",
          "description": "Directory containing skill definitions",
          "title": "Skills Dir"
        },
        "tools": {
          "description": "Declared tool contribution entries",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Tools",
          "type": "array"
        },
        "routers": {
          "description": "Declared API router contribution entries",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Routers",
          "type": "array"
        },
        "jobs": {
          "description": "Declared scheduled job handlers",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Jobs",
          "type": "array"
        },
        "safety_policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Import path to SafetyPolicy implementation",
          "title": "Safety Policy"
        },
        "routing": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Declarative domain routing hints",
          "title": "Routing"
        },
        "prompts_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "resources/prompts/",
          "description": "Prompt templates directory",
          "title": "Prompts Dir"
        },
        "locales_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "resources/locales/",
          "description": "Locale message bundles directory",
          "title": "Locales Dir"
        },
        "connectors_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "connectors/",
          "description": "Connector manifests directory",
          "title": "Connectors Dir"
        },
        "resources_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "resources/",
          "description": "Pack-native resource files directory",
          "title": "Resources Dir"
        },
        "workflows_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "workflows/",
          "description": "Pack-native workflow/pattern files directory",
          "title": "Workflows Dir"
        },
        "evals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Path to evals definition or dataset",
          "title": "Evals"
        },
        "errors_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional path to pack error catalog YAML file",
          "title": "Errors File"
        },
        "panels": {
          "description": "Declared multi-agent deliberation panels contributed by this pack",
          "items": {
            "$ref": "#/$defs/PackPanelSpec"
          },
          "title": "Panels",
          "type": "array"
        }
      },
      "title": "PackProvidesSpec",
      "type": "object"
    },
    "PackSafetySpec": {
      "additionalProperties": false,
      "description": "The ``safety`` block of ``pack.yaml``.",
      "properties": {
        "guards": {
          "anyOf": [
            {
              "$ref": "#/$defs/SafetyGuardsSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "PackSafetySpec",
      "type": "object"
    },
    "PanelDefaultConstraintSpec": {
      "description": "Specification of default constraint declared by a panel.",
      "properties": {
        "id": {
          "description": "Constraint slug identifier",
          "pattern": "^[a-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Human-readable description of constraint",
          "title": "Description",
          "type": "string"
        },
        "unit": {
          "description": "Measurement unit matching closed unit registry",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "id",
        "unit"
      ],
      "title": "PanelDefaultConstraintSpec",
      "type": "object"
    },
    "ReadScopeSpec": {
      "description": "Specification of a cross-domain scope read by a pack.",
      "properties": {
        "id": {
          "description": "Scope identifier of another pack e.g. 'household.calendar'",
          "title": "Id",
          "type": "string"
        },
        "level": {
          "default": "read",
          "description": "Requested access level",
          "enum": [
            "read",
            "write",
            "approve"
          ],
          "title": "Level",
          "type": "string"
        },
        "purpose": {
          "default": "",
          "description": "Functional purpose for requesting cross-scope access",
          "title": "Purpose",
          "type": "string"
        },
        "optional": {
          "default": true,
          "description": "Whether the pack can function if this grant is not given",
          "title": "Optional",
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "title": "ReadScopeSpec",
      "type": "object"
    },
    "RuleNormalizeSpec": {
      "additionalProperties": false,
      "description": "A regex substitution applied to the text before patterns are checked.",
      "properties": {
        "pattern": {
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "replace": {
          "default": "",
          "title": "Replace",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "RuleNormalizeSpec",
      "type": "object"
    },
    "RulePatternSpec": {
      "additionalProperties": false,
      "description": "One pattern of a ``rules`` check. A match blocks the text.",
      "properties": {
        "id": {
          "description": "Pattern id, reported in audit records.",
          "pattern": "^[a-z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "pattern": {
          "description": "Regex. <NAME> inserts a fragment from `blocks`.",
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        },
        "category": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Refusal category; defaults to the pattern id.",
          "title": "Category"
        },
        "scope": {
          "default": "text",
          "description": "text: search the whole text; sentence: search each sentence (see sentence_split).",
          "enum": [
            "text",
            "sentence"
          ],
          "title": "Scope",
          "type": "string"
        },
        "flags": {
          "description": "Regex flags.",
          "items": {
            "enum": [
              "ignorecase",
              "multiline",
              "dotall"
            ],
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "id",
        "pattern"
      ],
      "title": "RulePatternSpec",
      "type": "object"
    },
    "SafetyGuardsSpec": {
      "additionalProperties": false,
      "description": "Guard checks and how their answers are released (``safety.guards``).",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/GuardCheckSpec"
          },
          "maxItems": 16,
          "title": "Checks",
          "type": "array"
        },
        "deadline_s": {
          "default": 20.0,
          "description": "Wall-clock budget for all model checks of one text.",
          "exclusiveMinimum": 0,
          "maximum": 300,
          "title": "Deadline S",
          "type": "number"
        },
        "refusal_template": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Text shown when a guard refuses. Default: the safety policy's refusal template.",
          "title": "Refusal Template"
        },
        "release": {
          "default": "stream",
          "description": "stream: send answer tokens as they are generated (done carries the verdict); buffered: send the answer only after the final check passes.",
          "enum": [
            "stream",
            "buffered"
          ],
          "title": "Release",
          "type": "string"
        }
      },
      "title": "SafetyGuardsSpec",
      "type": "object"
    },
    "ScopeDefinitionSpec": {
      "description": "Specification of a scope owned by a pack.",
      "properties": {
        "id": {
          "description": "Unique scope identifier e.g. 'workspace.records', 'operations.accounts'",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "Human-readable description of data protected by this scope",
          "title": "Description",
          "type": "string"
        },
        "consent": {
          "default": "optional",
          "description": "Whether explicit user consent is required before first write",
          "enum": [
            "required",
            "optional"
          ],
          "title": "Consent",
          "type": "string"
        },
        "sensitivity": {
          "default": "internal",
          "description": "Data sensitivity classification driving encryption and egress policies",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "pii"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ScopeDefinitionSpec",
      "type": "object"
    },
    "SynthesisSpec": {
      "additionalProperties": false,
      "description": "How the main agent composes its reply (``orchestration.synthesis``).",
      "properties": {
        "instructions": {
          "default": "",
          "description": "Extra guidance appended to the main agent's system prompt for composing the reply.",
          "maxLength": 4000,
          "title": "Instructions",
          "type": "string"
        }
      },
      "title": "SynthesisSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Pydantic model representing a pack.yaml manifest file on disk.",
  "properties": {
    "pack_api": {
      "default": 1,
      "description": "Pack API specification version integer",
      "title": "Pack Api",
      "type": "integer"
    },
    "id": {
      "description": "Unique brand-neutral pack slug e.g. 'health', 'finance', 'kids'",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "description": "Display name of the pack",
      "title": "Name",
      "type": "string"
    },
    "version": {
      "description": "SemVer string of this pack version",
      "title": "Version",
      "type": "string"
    },
    "domain": {
      "description": "Primary domain identifier (e.g. 'health', 'finance', 'education', 'household')",
      "title": "Domain",
      "type": "string"
    },
    "requires_core": {
      "description": "PEP 440 / SemVer range for yarvelle-core e.g. '>=0.1.0,<0.2.0'",
      "title": "Requires Core",
      "type": "string"
    },
    "requires_packs": {
      "description": "Dependencies on other packs",
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Requires Packs",
      "type": "array"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "License expression",
      "title": "License"
    },
    "maintainers": {
      "description": "Maintainer usernames or teams",
      "items": {
        "type": "string"
      },
      "title": "Maintainers",
      "type": "array"
    },
    "risk_tier_max": {
      "default": "T2",
      "description": "Highest risk tier permitted for any action",
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4"
      ],
      "title": "Risk Tier Max",
      "type": "string"
    },
    "scopes": {
      "description": "Scopes owned by this pack",
      "items": {
        "$ref": "#/$defs/ScopeDefinitionSpec"
      },
      "title": "Scopes",
      "type": "array"
    },
    "reads": {
      "description": "Scopes of other packs requested for reading",
      "items": {
        "$ref": "#/$defs/ReadScopeSpec"
      },
      "title": "Reads",
      "type": "array"
    },
    "provides": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackProvidesSpec"
        },
        {
          "type": "null"
        }
      ],
      "description": "Contributed runtime artifacts"
    },
    "cross_pack_grants": {
      "description": "Explicit cross-pack grants authorizing foreign packs to participate in deliberation panels (ADR 0001 \u00a72.9)",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/CrossPackGrantSpec"
          }
        ]
      },
      "title": "Cross Pack Grants",
      "type": "array"
    },
    "migrations": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackMigrationsSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Database migration branch spec"
    },
    "compat": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Compatibility metadata",
      "title": "Compat"
    },
    "orchestration": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackOrchestrationSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Default agent, fixed routes and limits for multi-agent orchestration"
    },
    "safety": {
      "anyOf": [
        {
          "$ref": "#/$defs/PackSafetySpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Guard checks that run after the safety policy (safety.guards)"
    },
    "error_prefix": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional disjoint uppercase error code prefix e.g. 'CFD' or 'FIN'",
      "title": "Error Prefix"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "domain",
    "requires_core"
  ],
  "title": "Yarvelle Pack Manifest Schema (Pack API v1)",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yarvelle.org/v1/pack.schema.json"
}
