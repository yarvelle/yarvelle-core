{
  "$defs": {
    "AgentDomain": {
      "enum": [
        "wellness",
        "care",
        "therapy",
        "navigation",
        "education",
        "finance",
        "retail",
        "operations",
        "general"
      ],
      "title": "AgentDomain",
      "type": "string"
    },
    "RiskClass": {
      "enum": [
        "wellness",
        "admin",
        "education",
        "clinical_assist"
      ],
      "title": "RiskClass",
      "type": "string"
    },
    "SkillFrontmatterMetadata": {
      "additionalProperties": true,
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "risk_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "domain": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentDomain"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category"
        },
        "tools": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tools"
        },
        "forbidden": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Forbidden"
        },
        "evals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evals"
        },
        "tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tags"
        }
      },
      "title": "SkillFrontmatterMetadata",
      "type": "object"
    }
  },
  "additionalProperties": true,
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "license": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "domain": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentDomain"
        },
        {
          "type": "null"
        }
      ],
      "default": "wellness"
    },
    "category": {
      "default": "",
      "title": "Category",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "allowed-tools": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allowed-Tools"
    },
    "compatibility": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compatibility"
    },
    "metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/SkillFrontmatterMetadata"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "name",
    "description"
  ],
  "title": "Yarvelle Skill Frontmatter Schema",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yarvelle.org/v1/skill.schema.json"
}
