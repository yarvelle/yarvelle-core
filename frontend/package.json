{
  "name": "@yarvelle/ui",
  "version": "0.2.3",
  "description": "Domain-neutral UI component library and design system for Yarvelle",
  "keywords": [
    "yarvelle",
    "react",
    "ui",
    "components",
    "design-system",
    "design-tokens",
    "tailwind",
    "ai-agents",
    "chat-ui",
    "local-first"
  ],
  "homepage": "https://github.com/yarvelle/yarvelle-core/tree/main/frontend#readme",
  "bugs": {
    "url": "https://github.com/yarvelle/yarvelle-core/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yarvelle/yarvelle-core",
    "directory": "frontend"
  },
  "license": "PolyForm-Noncommercial-1.0.0 AND LicenseRef-Yarvelle-Core-Additional-Terms",
  "author": {
    "name": "Spectrayan",
    "email": "engineering@spectrayan.com",
    "url": "https://spectrayan.com"
  },
  "contributors": [
    {
      "name": "Yarvelle",
      "email": "yarvelle@spectrayan.com",
      "url": "https://github.com/yarvelle"
    }
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "NOTICE",
    "ADDITIONAL-TERMS.md",
    "TRADEMARKS.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/tokens/tailwind-preset.d.ts",
      "import": "./dist/tokens/tailwind-preset.js"
    },
    "./slots": {
      "types": "./dist/slots/index.d.ts",
      "import": "./dist/slots/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "bin": {
    "yarvelle-ui-codegen": "bin/yarvelle-ui-codegen.js"
  },
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs",
    "build": "node scripts/build-tokens.mjs && tsup && cp src/tokens/tokens.css dist/styles.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18.2.0 || >=19.0.0",
    "react-dom": ">=18.2.0 || >=19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "^20.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.11"
  }
}
